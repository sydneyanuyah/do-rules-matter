# Local paths only. Never commit credentials or presigned URLs.
PAPER1_PROJECT_ROOT=/absolute/path/to/Paper1-HEF-GitHub
PAPER1_DATA_ROOT=/absolute/path/to/public/data
PAPER1_ARTIFACT_ROOT=/absolute/path/to/artifacts

# Optional cloud synchronization. Set these in your shell, not in source files.
AWS_PROFILE=your-approved-profile
AWS_REGION=us-east-1
PAPER1_S3_ROOT=s3://your-approved-bucket/your-prefix
EXPECTED_AWS_ACCOUNT=000000000000
